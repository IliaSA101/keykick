# Скрипты установки пакетов не запускаются: заражённая версия не выполнит код при npm install / npm ci
# (web-frontend packages.md §4, владелец 14.11). У нас пакетов с нужной установкой нет; если понадобится — npm rebuild <пакет>.
# min-release-age и allow-git npm 11.6.2 не понимает (предупреждение на каждой команде) — после обновления npm.
ignore-scripts=true
# npx без терминала (у агентов) молча ставит и запускает недостающий пакет из реестра; yes=false — отказ вместо установки.
# Локальные программы (eslint, vite, vitest, playwright) идут как раньше; чужой пакет разово — npx --yes, со словом владельца.
yes=false
