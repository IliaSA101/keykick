#!/bin/sh
# Ловит механические ошибки до того, как они попадут в историю:
# лишние файлы, выросшие файлы, ошибки линтера и типов. Тесты — в pre-push.
# Включение: git config core.hooksPath .githooks
# Осознанный обход: git commit --no-verify (причину — в описание коммита).
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
fail=0

# 1. Чего в репозитории быть не должно.
for file in $staged; do
  case "$file" in
    node_modules/*|*/node_modules/*|dist/*|*.tsbuildinfo|art-src/*|art-work/*)
      echo "pre-commit: $file не место в репозитории"; fail=1 ;;
    .*/compact-next.md|.*/measurements/*|.*/settings.local.json)
      echo "pre-commit: $file — рабочие данные агента"; fail=1 ;;
    .env.example) ;;
    .env|.env.*)
      echo "pre-commit: $file — локальные настройки"; fail=1 ;;
  esac
done

# 2. Размер файлов кода: порог 600 строк (правило из общих знаний).
# Новый файл сверх порога и файл, перешагнувший порог этим коммитом, — блок;
# давно крупный файл, который ещё вырос, — предупреждение.
LIMIT=600
for file in $staged; do
  case "$file" in
    src/*.ts|src/*.vue|tools/*.mjs|tests/*.ts|.*/hooks/*.mjs) ;;
    *) continue ;;
  esac
  [ -f "$file" ] || continue
  now=$(git show ":$file" | wc -l | tr -d ' ')
  [ "$now" -le "$LIMIT" ] && continue
  was=$(git show "HEAD:$file" 2>/dev/null | wc -l | tr -d ' ')
  : "${was:=0}"
  if [ "$was" -le "$LIMIT" ]; then
    echo "pre-commit: $file — $now строк при пороге $LIMIT, разрежьте по обязанностям"
    fail=1
  elif [ "$now" -gt "$was" ]; then
    echo "pre-commit: предупреждение — $file и так большой ($was), стал $now"
  fi
done

# 2б. Структура (журнал 08.11 «Структура кода»): новый файл кода в engine, app, components, screens —
# только в папку подсистемы (`src/engine/save/…`), корни слоёв не растут. Файлы v1 в корнях живут,
# пока их не заменит v2; переезд в подсистему (git mv) — не новый файл.
added=$(git diff --cached --name-only --diff-filter=A)
for file in $added; do
  case "$file" in
    src/engine/*/*|src/app/*/*|src/components/*/*|src/screens/*/*) ;;
    src/engine/*.ts|src/app/*.ts|src/components/*.vue|src/screens/*.vue)
      echo "pre-commit: $file — новый файл в корне слоя; положите в папку подсистемы (например, ${file%/*}/save/)"
      fail=1 ;;
  esac
done
# Подсистема шире 12 файлов — пора делить на части (предупреждение).
for dir in $(echo "$added" | grep -E '^src/(engine|app|components|screens)/[^/]+/' | cut -d/ -f1-3 | sort -u); do
  n=$(git ls-files --cached "$dir" | grep -cE '\.(ts|vue)$')
  [ "$n" -gt 12 ] && echo "pre-commit: предупреждение — в $dir уже $n файлов кода, разделите подсистему"
done
# Мягкий порог 400: файл перешагнул его этим коммитом — время планировать разрез, а не ждать блока на 600.
for file in $staged; do
  case "$file" in src/*.ts|src/*.vue) ;; *) continue ;; esac
  [ -f "$file" ] || continue
  now=$(git show ":$file" | wc -l | tr -d ' ')
  was=$(git show "HEAD:$file" 2>/dev/null | wc -l | tr -d ' ')
  : "${was:=0}"
  [ "$now" -gt 400 ] && [ "$was" -le 400 ] && echo "pre-commit: предупреждение — $file перешагнул 400 строк ($now): разрез по обязанностям — в ближайшую задачу"
done

# 3. Линтер по изменённым файлам кода: он стережёт правила проекта.
code=$(echo "$staged" | grep -E '\.(ts|vue)$' || true)
if [ -n "$code" ]; then
  # shellcheck disable=SC2086
  npx eslint --max-warnings 0 $code || fail=1

  # 4. Типы по всему проекту: ошибка в одном файле ломает импорт в другом (так уже прошло
  # в коммит 176910f). vue-tsc смотрит рабочую копию, а не индекс, — для обычного коммита
  # «всё изменённое» это одно и то же.
  npx vue-tsc --noEmit || fail=1
fi

[ "$fail" -eq 0 ] || { echo "pre-commit: коммит остановлен"; exit 1; }
