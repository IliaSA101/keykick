#!/bin/sh
# Ловит механические ошибки до того, как они попадут в историю:
# лишние файлы, выросшие файлы, ошибки линтера и типов. Тесты — в pre-push.
# Включение: git config core.hooksPath .githooks
# Осознанный обход: git commit --no-verify (причину — в описание коммита).
set -u

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
fail=0

# 1. Чего в репозитории быть не должно.
for file in $staged; do
  case "$file" in
    node_modules/*|*/node_modules/*|dist/*|*.tsbuildinfo|art-src/*|art-work/*)
      echo "pre-commit: $file не место в репозитории"; fail=1 ;;
    .*/compact-next.md|.*/measurements/*|.*/settings.local.json)
      echo "pre-commit: $file — рабочие данные агента"; fail=1 ;;
    .seeloop/*|*/.seeloop/*)
      # Хранилище seeloop (журнал, круги, токены) — никогда в git; `git add -f .` снимает и .gitignore (владелец 14.11, Б4).
      echo "pre-commit: $file — хранилище seeloop, в git нельзя"; fail=1 ;;
    .env.example) ;;
    .env|.env.*)
      echo "pre-commit: $file — локальные настройки"; fail=1 ;;
  esac
done

# 2. Размер файлов кода: порог 600 строк (правило из общих знаний).
# Новый файл сверх порога и файл, перешагнувший порог этим коммитом, — блок;
# давно крупный файл, который ещё вырос, — предупреждение.
LIMIT=600
for file in $staged; do
  case "$file" in
    src/*.ts|src/*.vue|tools/*.mjs|tests/*.ts|.*/hooks/*.mjs|gate/*.ts|gate/*.mjs) ;;  # gate/ — сторож доступа (059-Р1, владелец 17.11)
    *) continue ;;
  esac
  [ -f "$file" ] || continue
  now=$(git show ":$file" | wc -l | tr -d ' ')
  [ "$now" -le "$LIMIT" ] && continue
  was=$(git show "HEAD:$file" 2>/dev/null | wc -l | tr -d ' ')
  : "${was:=0}"
  if [ "$was" -le "$LIMIT" ]; then
    echo "pre-commit: $file — $now строк при пороге $LIMIT, разрежьте по обязанностям"
    fail=1
  elif [ "$now" -gt "$was" ]; then
    echo "pre-commit: предупреждение — $file и так большой ($was), стал $now"
  fi
done

# 2б. Структура (журнал 08.11 «Структура кода»): новый файл кода в engine, app, components, screens —
# только в папку подсистемы (`src/engine/save/…`), корни слоёв не растут. Файлы v1 в корнях живут,
# пока их не заменит v2; переезд в подсистему (git mv) — не новый файл.
added=$(git diff --cached --name-only --diff-filter=A)
for file in $added; do
  case "$file" in
    src/engine/*/*|src/app/*/*|src/components/*/*|src/screens/*/*) ;;
    src/engine/*.ts|src/app/*.ts|src/components/*.vue|src/screens/*.vue)
      echo "pre-commit: $file — новый файл в корне слоя; положите в папку подсистемы (например, ${file%/*}/save/)"
      fail=1 ;;
  esac
done
# Подсистема шире 12 файлов — пора делить на части (предупреждение).
for dir in $(echo "$added" | grep -E '^src/(engine|app|components|screens)/[^/]+/' | cut -d/ -f1-3 | sort -u); do
  n=$(git ls-files --cached "$dir" | grep -cE '\.(ts|vue)$')
  [ "$n" -gt 12 ] && echo "pre-commit: предупреждение — в $dir уже $n файлов кода, разделите подсистему"
done
# Мягкий порог 400: файл перешагнул его этим коммитом — время планировать разрез, а не ждать блока на 600.
for file in $staged; do
  case "$file" in src/*.ts|src/*.vue) ;; *) continue ;; esac
  [ -f "$file" ] || continue
  now=$(git show ":$file" | wc -l | tr -d ' ')
  was=$(git show "HEAD:$file" 2>/dev/null | wc -l | tr -d ' ')
  : "${was:=0}"
  [ "$now" -gt 400 ] && [ "$was" -le 400 ] && echo "pre-commit: предупреждение — $file перешагнул 400 строк ($now): разрез по обязанностям — в ближайшую задачу"
done

# 3. Линтер по изменённым файлам кода: он стережёт правила проекта.
code=$(echo "$staged" | grep -E '\.(ts|vue)$' || true)
if [ -n "$code" ]; then
  # shellcheck disable=SC2086
  npx eslint --max-warnings 0 $code || fail=1

  # 4. Типы по всему проекту: ошибка в одном файле ломает импорт в другом (так уже прошло
  # в коммит 176910f). vue-tsc смотрит рабочую копию, а не индекс, — для обычного коммита
  # «всё изменённое» это одно и то же.
  npx vue-tsc --noEmit || fail=1
fi

# 5. Дизайн-макеты (ретро 023, владелец 10.11: П4, П13).
# Кадры макетов и холста в git не хранятся (владелец 12.11: история 9,4 ГБ, из них 8,1 ГБ — пересобираемые кадры;
# keykick-dev пересобран без них, полная история — keykick-dev-archive). Кадры — на диске (пересобирает генератор),
# снимки принятых макетов — архивом в выпуски (Releases) keykick-dev, версии для «было / стало» — свой холст.
shots=$(echo "$staged" | grep -E '^docs/mockups/.*/png/|^\.[a-z]+/ops/schemes/canvas/project/shots/' || true)
if [ -n "$shots" ]; then
  echo "pre-commit: кадры ($(echo "$shots" | wc -l | tr -d ' ') файлов) в git не хранятся — убрать из коммита: git restore --staged <пути>"
  echo "  принятый макет — архивом в выпуск keykick-dev (docs/mockup-guide.md)"
  fail=1
fi
# Стражи макета — когда коммит трогает генераторы или макеты: сверка частей (0,04 с) и ТАБУ (≈ 4 с).
if echo "$staged" | grep -qE '^(tools/mock-|tools/mock-map/|tools/mock-kit/|tools/mock-mk1/|docs/mockups/)'; then
  node tools/mock-check.mjs > /dev/null || { node tools/mock-check.mjs | tail -5; fail=1; }
  python3 tools/mock-map/qc.py taboo > /dev/null 2>&1 || { python3 tools/mock-map/qc.py taboo | tail -5; fail=1; }
fi

# 6. База знаний docs/kb (владелец 17.11) — собирается из первоисточников, руками не ведётся.
# Коммит трогает журнал графики, журнал решений, спеки или сам сборщик — пересобрать и добавить в тот же коммит.
# Сборщик читает рабочую копию: неиндексированная правка тех же файлов попадёт в базу раньше самой правки
# (как vue-tsc выше) — для обычного коммита это одно и то же.
# Ветка, отрезанная до появления базы (рабочие копии делят hooksPath), сборщика не имеет — пропускаем.
if [ -f tools/kb/build.mjs ] && echo "$staged" | grep -qE '^(docs/art-pipeline\.md|docs/design\.md|docs/specs/|docs/mockups/accepted\.json|tools/kb/)'; then
  if node tools/kb/build.mjs > /dev/null; then
    git add -A docs/kb
  else
    echo "pre-commit: сборка docs/kb упала — node tools/kb/build.mjs"; fail=1
  fi
fi

# 6а. Термины (066 Т3, органалитика вопрос 6): «Э1»/«П3» без слова «этап» или «лист» в добавленных строках .md —
# только предупреждение, коммит не держит.
if [ -f tools/kb/terms-check.mjs ]; then node tools/kb/terms-check.mjs || true; fi

# 7. Дашборд docs/progress (владелец 18.11) — задачи и прогноз собираются из спек, руками не ведутся.
# Коммит трогает спеки, дашборд или сборщик — пересобрать и добавить в тот же коммит.
# Ветка, отрезанная до появления сборщика, его не имеет — пропускаем.
if [ -f tools/progress/build.mjs ] && echo "$staged" | grep -qE '^(docs/specs/|docs/progress/|tools/progress/)'; then
  if node tools/progress/build.mjs > /dev/null; then
    git add docs/progress
  else
    echo "pre-commit: сборка docs/progress упала — node tools/progress/build.mjs"; fail=1
  fi
fi

[ "$fail" -eq 0 ] || { echo "pre-commit: коммит остановлен"; exit 1; }
